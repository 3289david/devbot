# ── Required ──────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ── Strongly recommended ──────────────────
# Enables translation, 3-line summaries, impact analysis and "AI에게 질문".
# Without it the bot still works with rule-based summaries.
ANTHROPIC_API_KEY=
# GitHub token (no scopes needed) raises the API limit from 60 to 5000 req/h.
GITHUB_TOKEN=

# ── Optional ──────────────────────────────
# Register slash commands to one server instantly while developing (global registration can take up to 1h).
DEV_GUILD_ID=
AI_ANALYSIS_MODEL=claude-haiku-5-5
AI_ASK_MODEL=claude-sonnet-5-5
ASK_DAILY_LIMIT=30
POLL_MINUTES=15
TRENDING_HOURS=6
MAX_ITEMS_PER_CYCLE=12
MAX_AGE_HOURS=36
DATA_DIR=./data
